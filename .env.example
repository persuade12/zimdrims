# Production RPC base. Use the HTTPS host, not the internal address.
ZIMDRIMS_API_BASE_URL=https://dcp.dikarabo.co.za

# Database prefix on each procedure, e.g. zimdrims_db.dbo.select_login.
ZIMDRIMS_DB_NAME=zimdrims_db

# live calls select_login. demo keeps the local sample accounts.
ZIMDRIMS_AUTH_MODE=live
